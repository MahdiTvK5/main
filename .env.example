# ===== Telegram =====
BOT_TOKEN=
# آیدی عددی مدیر کل
SUPER_ADMIN_ID=0
# در صورت نیاز به پروکسی برای اتصال به تلگرام (اختیاری)
PROXY_URL=

# ===== X-UI Panel =====
PANEL_URL=https://your-panel-domain:port/path
PANEL_USER=
PANEL_PASS=
# آی‌پی یا دامنه‌ای که در لینک کانفیگ (vless) استفاده می‌شود
CONFIG_IP=

# ===== پنل وب مدیریت =====
# اگر خالی بماند، پنل وب اجرا نمی‌شود.
WEB_ADMIN_PASSWORD=
WEB_PORT=8080
WEB_HOST=0.0.0.0

# ===== Database (PostgreSQL) =====
# این مقادیر قبلاً داخل سورس هاردکد بودند؛ حالا از محیط خوانده می‌شوند.
# توصیه می‌شود رمز عبور را تغییر دهید چون رمز قبلی در تاریخچه‌ی گیت لو رفته است.
DB_USER=overwall_user
DB_PASS=change-me
DB_NAME=overwall_db
DB_HOST=127.0.0.1
DB_PORT=5432
