# ===== Telegram =====
BOT_TOKEN=
# آیدی عددی مدیر کل
SUPER_ADMIN_ID=0
# در صورت نیاز به پروکسی برای اتصال به تلگرام (اختیاری)
PROXY_URL=

# ===== X-UI Panel =====
PANEL_URL=https://your-panel-domain:port/path
PANEL_USER=
PANEL_PASS=
# آی‌پی یا دامنه‌ای که در لینک کانفیگ (vless) استفاده می‌شود
CONFIG_IP=

# ===== پنل وب مدیریت =====
# اگر خالی بماند، پنل وب اجرا نمی‌شود. رمز قوی بگذارید.
WEB_ADMIN_PASSWORD=
WEB_PORT=8080
# پیش‌فرض فقط لوکال‌هاست؛ برای دسترسی از بیرون Nginx با TLS جلوی آن بگذارید (README).
WEB_HOST=127.0.0.1
# عمر نشست پنل وب به ثانیه (پیش‌فرض ۱۲ ساعت)
WEB_SESSION_TTL=43200

# ===== Database (PostgreSQL) =====
# این مقادیر قبلاً داخل سورس هاردکد بودند؛ حالا از محیط خوانده می‌شوند.
# DB_PASS اجباری است؛ بدون آن ربات بالا نمی‌آید.
DB_USER=overwall_user
DB_PASS=change-me
DB_NAME=overwall_db
DB_HOST=127.0.0.1
DB_PORT=5432
